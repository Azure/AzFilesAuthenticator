#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	./autogen.sh || autoreconf -fi
	PYTHON_SITE_PKG=/usr/lib/python3/dist-packages ./configure --prefix=/usr

override_dh_auto_build:
	make

override_dh_auto_install:
	make install DESTDIR=$(CURDIR)/debian/azfilesauth

override_dh_install:
	dh_install --sourcedir=debian/azfilesauth

override_dh_fixperms:
	dh_fixperms --exclude=etc/azfilesauth/config.yaml
	chmod 0600 debian/azfilesauth/etc/azfilesauth/config.yaml

# Exclude the private virtual environment under /opt/azfilesauth/venv from stripping and shlibdeps.
override_dh_shlibdeps:
	dh_shlibdeps -Xopt/azfilesauth/venv

override_dh_strip:
	dh_strip -Xopt/azfilesauth/venv

override_dh_dwz:
	dh_dwz -Xopt/azfilesauth/venv

override_dh_strip_nondeterminism:
	dh_strip_nondeterminism -Xopt/azfilesauth/venv
