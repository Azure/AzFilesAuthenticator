#!/bin/sh
set -e

case "$1" in
    configure)
        # Fallback: install Azure Python SDK via pip if not satisfied by package manager.
        # The preferred path is via packages.microsoft.com which provides
        # python3-azure-identity and python3-azure-core as native .deb packages.
        # This fallback handles environments where that repo is not configured.
        if [ "${AZFILESAUTH_SKIP_PIP_INSTALL:-0}" = "1" ]; then
            echo "azfilesauth: skipping azure-identity pip fallback because AZFILESAUTH_SKIP_PIP_INSTALL=1"
        elif ! python3 -c "import azure.identity" 2>/dev/null; then
            echo "azfilesauth: azure-identity not found via apt; attempting pip install..."
            PIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-input --no-cache-dir --retries 2 --timeout 15 \
                "azure-identity>=1.14.0" "azure-core>=1.26.0" 2>/dev/null || \
            PIP_DISABLE_PIP_VERSION_CHECK=1 python3 -m pip install --quiet --no-input --no-cache-dir --retries 2 --timeout 15 --break-system-packages \
                "azure-identity>=1.14.0" "azure-core>=1.26.0" || \
                echo "WARNING: azure-identity could not be installed. Add packages.microsoft.com repo or run: pip3 install azure-identity azure-core"
        fi
        ;;
esac

#DEBHELPER#
